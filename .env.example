# Frontend Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
DOWNLOADER_API_URL=http://localhost:8080
DOWNLOADER_API_KEY=dev-secret-api-key-12345

# Worker Configuration
WORKER_PORT=8080
WORKER_HOST=0.0.0.0
TEMP_STORAGE_DIR=/tmp/video-downloader
CLEANUP_INTERVAL_SECONDS=60

# Concurrency & Retention
MAX_CONCURRENT_JOBS=2
JOB_TTL_MINUTES=30

# Rate Limiting (per IP per hour)
RATE_LIMIT_ANALYZE=20
RATE_LIMIT_DOWNLOAD=10
